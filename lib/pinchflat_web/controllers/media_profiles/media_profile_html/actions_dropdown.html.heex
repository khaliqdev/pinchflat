<.button_dropdown text="Actions" class="justify-center w-full sm:w-50">
  <:option>
    <button
      type="button"
      class="text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      x-data="{ copied: false }"
      x-on:click={~s"
        copyWithCallbacks(
          String.raw`#{Jason.Formatter.pretty_print(Phoenix.json_library().encode!(@media_profile))}`,
          () => copied = true,
          () => copied = false
        )
      "}
    >
      Copy JSON
      <span x-show="copied" x-transition.duration.150ms>
        <.icon name="hero-check" class="ml-2 h-4 w-4" />
      </span>
    </button>
  </:option>
  <:option>
    <.link href={~p"/media_profiles/new?template_id=#{@media_profile}"} method="get">
      Use as Template
    </.link>
  </:option>
  <:option>
    <div class="h-px w-full bg-bodydark2"></div>
  </:option>
  <:option>
    <.link
      href={~p"/media_profiles/#{@media_profile}"}
      method="delete"
      data-confirm-dialog
      data-confirm-title="Delete profile?"
      data-confirm-message="Are you sure you want to delete this profile and all its sources (leaving files in place)? This cannot be undone."
      data-confirm-confirm-text="Delete"
      data-confirm-kind="danger"
    >
      Delete Profile
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/media_profiles/#{@media_profile}?delete_files=true"}
      method="delete"
      data-confirm-dialog
      data-confirm-title="Delete profile and files?"
      data-confirm-message="Are you sure you want to delete this profile, all its sources, and its files on disk? This cannot be undone."
      data-confirm-confirm-text="Delete"
      data-confirm-kind="danger"
      class="mt-5 md:mt-0"
    >
      Delete Profile + Files
    </.link>
  </:option>
</.button_dropdown>
