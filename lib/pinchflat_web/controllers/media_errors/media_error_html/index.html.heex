<form
  x-data={"{ selected: [], pageIds: #{Jason.encode!(Enum.map(@errors, & &1.id))} }"}
  action={~p"/errors/retry-selected"}
  method="post"
  data-confirm-form
>
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-title-md2 font-bold text-black dark:text-white">Errors</h2>

    <div class="flex flex-wrap items-center gap-3">
      <span x-cloak x-show="selected.length > 0" class="text-sm text-bodydark2">
        <span x-text="selected.length"></span> selected
      </span>

      <button
        type="submit"
        x-cloak
        x-show="selected.length > 0"
        data-confirm-dialog
        data-confirm-title="Retry selected items?"
        data-confirm-message="Re-attempt downloads for the {count} selected item(s) that are still pending. Ignored items and already-downloaded items are skipped."
        class="rounded-md border border-primary px-3 py-1.5 text-sm font-medium text-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      >
        Retry selected
      </button>

      <button
        type="button"
        x-cloak
        x-show="selected.length > 0"
        x-on:click="selected = []"
        class="rounded-md border border-stroke px-3 py-1.5 text-sm font-medium text-bodydark2 hover:text-bodydark1 dark:border-strokedark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      >
        Clear selection
      </button>

      <.link
        :if={!Enum.empty?(@errors)}
        href={if @source_id, do: ~p"/errors/retry?source_id=#{@source_id}", else: ~p"/errors/retry"}
        method="post"
        data-confirm-dialog
        data-confirm-title="Retry errored items?"
        data-confirm-message={"Re-attempt downloads for errored items #{if @source_id, do: "in this source", else: "across all sources"} that are still pending. Ignored items and already-downloaded items are skipped. Each run covers the most recent 100 failures."}
        class="rounded-md border border-primary px-3 py-1.5 text-sm font-medium text-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      >
        Retry Errored
      </.link>

      <span :if={!Enum.empty?(@errors)} class="text-sm text-bodydark2">
        showing {length(@errors)} of {@total_errored} failures
      </span>

      <button
        :if={!Enum.empty?(@errors)}
        type="button"
        x-on:click="selected = pageIds"
        class="rounded-md border border-stroke px-3 py-1.5 text-sm font-medium text-bodydark2 hover:text-bodydark1 dark:border-strokedark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      >
        Select page
      </button>

      <nav class="flex flex-wrap items-center gap-2" aria-label="Filter errors by source">
        <.link
          href={~p"/errors"}
          class={[
            "rounded-md border px-3 py-1.5 text-sm font-medium",
            is_nil(@source_id) && "border-primary text-primary",
            !is_nil(@source_id) &&
              "border-strokedark text-bodydark2 hover:text-bodydark1",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
          ]}
        >
          All sources
        </.link>

        <.link
          :for={source <- @sources}
          href={~p"/errors?source_id=#{source.id}"}
          class={[
            "rounded-md border px-3 py-1.5 text-sm font-medium",
            @source_id == source.id && "border-primary text-primary",
            @source_id != source.id &&
              "border-strokedark text-bodydark2 hover:text-bodydark1",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
          ]}
        >
          {source.custom_name}
        </.link>
      </nav>
    </div>
  </div>

  <div
    :if={Enum.empty?(@errors)}
    class="rounded-sm border border-stroke bg-white px-5 py-8 text-center shadow-default dark:border-strokedark dark:bg-boxdark"
  >
    <p class="text-bodydark2">No errors recorded. Long may it continue!</p>
  </div>

  <div class="flex flex-col gap-4">
    <details
      :for={group <- @error_groups}
      id={group.id}
      data-error-group
      class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark"
    >
      <summary class="cursor-pointer rounded-sm px-5 py-4 text-black dark:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark">
        <span class="inline-flex max-w-full items-start gap-3 align-middle">
          <span class="shrink-0 rounded-md border border-red-200 bg-red-50 px-1.5 py-0.5 text-xs font-medium leading-4 text-red-700 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400">
            {group.count}
          </span>
          <span class="min-w-0 break-words text-sm font-medium">
            {group.label}
          </span>
        </span>
      </summary>

      <div class="divide-y divide-stroke border-t border-stroke dark:divide-strokedark dark:border-strokedark">
        <article :for={item <- group.items} class="px-5 py-4">
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="checkbox"
              name="selected_ids[]"
              value={item.id}
              x-model="selected"
              aria-label={"Select #{item.title}"}
              class="shrink-0 accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
            />

            <img
              :if={(item.thumbnail_filepath && item.uuid) || item.media_id}
              src={
                cond do
                  item.thumbnail_filepath && item.uuid ->
                    ~p"/media/#{item.uuid}/episode_image"

                  item.media_id ->
                    "https://i.ytimg.com/vi/#{item.media_id}/mqdefault.jpg"

                  true ->
                    nil
                end
              }
              alt=""
              loading="lazy"
              class="h-9 w-16 shrink-0 rounded-md border border-stroke dark:border-strokedark object-cover"
              onerror="this.classList.add('hidden')"
            />

            <.subtle_link href={~p"/sources/#{item.source_id}/media/#{item.id}"}>
              {item.title}
            </.subtle_link>

            <span class="text-sm text-bodydark2">in</span>

            <.subtle_link href={~p"/sources/#{item.source_id}"}>
              {item.source.custom_name}
            </.subtle_link>

            <span class="ml-auto text-sm text-bodydark2">
              {Pinchflat.Utils.DisplayTime.date_to_local(item.updated_at)}
            </span>
          </div>

          <details class="mt-3">
            <summary class="cursor-pointer rounded-sm text-sm text-zinc-600 dark:text-bodydark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark">
              Error output
            </summary>
            <pre class="mt-2 overflow-x-auto rounded-md border border-stroke dark:border-strokedark bg-gray-2 dark:bg-meta-4 p-3 font-mono text-xs leading-5 text-body dark:text-bodydark1">{String.trim_trailing(item.last_error || "")}</pre>
          </details>
        </article>
      </div>
    </details>
  </div>

  <input :if={@source_id} type="hidden" name="source_id" value={@source_id} />
</form>
