<.button_dropdown text="Actions" class="justify-center w-full sm:w-50">
  <:option>
    <button
      type="button"
      class="text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      x-data="{ copied: false }"
      x-on:click={~s"
        $event.preventDefault();
        copyWithCallbacks(
          '#{rss_feed_url(@conn, @source)}',
          () => copied = true,
          () => copied = false
        )
      "}
    >
      Copy RSS Feed
      <span x-show="copied" x-transition.duration.150ms>
        <.icon name="hero-check" class="ml-2 h-4 w-4" />
      </span>
    </button>
  </:option>
  <:option>
    <button
      type="button"
      class="text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
      x-data="{ copied: false }"
      x-on:click={~s"
        copyWithCallbacks(
          String.raw`#{Jason.Formatter.pretty_print(Phoenix.json_library().encode!(@source))}`,
          () => copied = true,
          () => copied = false
        )
      "}
    >
      Copy JSON
      <span x-show="copied" x-transition.duration.150ms>
        <.icon name="hero-check" class="ml-2 h-4 w-4" />
      </span>
    </button>
  </:option>
  <:option>
    <.link href={~p"/sources/new?template_id=#{@source}"} method="get">
      Use as Template
    </.link>
  </:option>
  <:option>
    <div class="h-px w-full bg-bodydark2"></div>
  </:option>
  <:option :if={@source.download_media}>
    <.link
      href={~p"/sources/#{@source}/force_download_pending"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Download pending media?"
      data-confirm-message="Are you sure you want to force a download of all pending media items? This isn't normally needed."
    >
      Download Pending
    </.link>
  </:option>
  <:option :if={@source.download_media}>
    <.link
      href={~p"/sources/#{@source}/force_redownload"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Redownload existing media?"
      data-confirm-message="Are you sure you want to re-download all currently downloaded media items? This doesn't upgrade your media, but will download any missing files if your settings have changed. This isn't normally needed."
    >
      Redownload Existing
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}/force_index"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Force index?"
      data-confirm-message="Are you sure you want index all content from this source? This isn't normally needed."
    >
      Force Index
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}/force_metadata_refresh"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Refresh metadata?"
      data-confirm-message="Are you sure you want to refresh this source's metadata?"
    >
      Refresh Metadata
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}/sync_files_on_disk"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Sync files on disk?"
      data-confirm-message="Are you sure you want to sync files? This will update media items if their files have been deleted. File addition or moves are not detected. This isn't normally needed."
    >
      Sync Files on Disk
    </.link>
  </:option>
  <:option>
    <div class="h-px w-full bg-bodydark2"></div>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}/delete_pending"}
      method="post"
      data-confirm-dialog
      data-confirm-title="Delete all pending media?"
      data-confirm-message="Are you sure you want to delete all pending media items for this source? They will be re-added if new content is still being indexed. This cannot be undone."
      data-confirm-confirm-text="Delete"
      data-confirm-kind="danger"
    >
      Delete All Pending
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}"}
      method="delete"
      data-confirm-dialog
      data-confirm-title="Delete source?"
      data-confirm-message="Are you sure you want to delete this source (leaving files in place)? This cannot be undone."
      data-confirm-confirm-text="Delete"
      data-confirm-kind="danger"
    >
      Delete Source
    </.link>
  </:option>
  <:option>
    <.link
      href={~p"/sources/#{@source}?delete_files=true"}
      method="delete"
      data-confirm-dialog
      data-confirm-title="Delete source and files?"
      data-confirm-message="Are you sure you want to delete this source and it's files on disk? This cannot be undone."
      data-confirm-confirm-text="Delete"
      data-confirm-kind="danger"
      class="mt-5 md:mt-0"
    >
      Delete Source + Files
    </.link>
  </:option>
</.button_dropdown>
