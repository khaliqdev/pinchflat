<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      {assigns[:page_title] || "re:Pinchflat"}
    </.live_title>
    <script>
      // Applies the effective theme before first paint to avoid a flash.
      // Priority: per-browser toggle (localStorage) > server default > system.
      (function () {
        var serverDefault = "<%= Settings.get!(:default_theme) %>";
        var stored = null;
        try { stored = localStorage.getItem("re-theme"); } catch (e) {}
        var mode = stored || serverDefault || "dark";
        var dark = mode === "dark" || (mode !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        window.__reThemeIsDark = dark;
        document.documentElement.classList.add(dark ? "theme-dark" : "theme-light");
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/re-pinchflat-icon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/re-pinchflat-icon-32.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/re-pinchflat-icon-180.png"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body
    x-data={"{ 
      sidebarVisible: false,
      onboarding: #{Settings.get!(:onboarding)}
    }"}
    class="text-bodydark"
    data-socket-path={Path.join(Application.get_env(:pinchflat, :base_route_path), "/live")}
  >
    {@inner_content}

    <.confirm_dialog />
  </body>
</html>
