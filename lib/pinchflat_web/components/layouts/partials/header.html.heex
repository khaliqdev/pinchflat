<header class="sticky top-0 z-999 flex min-h-16 w-full bg-white drop-shadow-1 dark:bg-boxdark dark:drop-shadow-none">
  <div class="flex w-full flex-grow items-center justify-between gap-3 px-4 py-3 shadow-2 md:px-6 2xl:px-11">
    <div class="flex min-w-0 items-center gap-3">
      <.link href={~p"/"} class="flex shrink-0 items-center gap-2.5 lg:invisible">
        <img src={~p"/images/re-pinchflat-icon.svg"} alt="re:Pinchflat" class="h-8 w-8" />
        <span class="hidden text-base font-bold tracking-tight text-black dark:text-white sm:block">
          re<span class="text-primary">:</span>Pinchflat
        </span>
      </.link>

      <button
        type="button"
        aria-label="Toggle sidebar"
        x-bind:aria-expanded="sidebarVisible ? 'true' : 'false'"
        class="z-99999 block rounded-sm border border-stroke bg-white p-1.5 shadow-sm dark:border-strokedark dark:bg-boxdark lg:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-boxdark"
        @click.stop="sidebarVisible = !sidebarVisible"
      >
        <.icon name="hero-bars-3" />
      </button>
    </div>

    <div class="flex items-center gap-3">
      <div class="w-44 sm:w-64 xl:w-80">
        <div class="relative rounded-md focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2 dark:focus-within:ring-offset-boxdark">
          <span class="absolute left-2 top-1/2 -translate-y-1/2 flex">
            <.icon name="hero-magnifying-glass" />
          </span>
          <form action={~p"/search"}>
            <input
              type="text"
              name="q"
              value={@params["q"]}
              placeholder="Search all media..."
              aria-label="Search all media"
              class="w-full bg-transparent py-1.5 pl-9 pr-4 border-0 focus:ring-0 focus:outline-none"
            />
          </form>
        </div>
      </div>

      <button
        type="button"
        x-data
        @click="(() => {
          const dark = document.documentElement.classList.toggle('dark');
          document.documentElement.classList.toggle('theme-dark', dark);
          document.documentElement.classList.toggle('theme-light', !dark);
          try { localStorage.setItem('re-theme', dark ? 'dark' : 'light'); } catch (e) {}
        })()"
        class="rounded-md border border-stroke p-2 text-bodydark2 dark:border-strokedark hover:text-bodydark1"
        aria-label="Toggle theme"
        title="Toggle dark/light theme"
      >
        <.icon name="hero-sun" class="hidden h-5 w-5 dark:block" />
        <.icon name="hero-moon" class="h-5 w-5 dark:hidden" />
      </button>

      {live_render(@conn, Pinchflat.Pages.StatusChipsLive, id: "status-chips")}
    </div>
  </div>
</header>
