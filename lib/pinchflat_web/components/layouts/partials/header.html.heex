<header class="sticky top-0 z-999 flex min-h-16 w-full bg-white drop-shadow-1 dark:bg-boxdark dark:drop-shadow-none">
  <div class="flex w-full flex-grow items-center justify-between gap-3 px-4 py-3 shadow-2 md:px-6 2xl:px-11">
    <div class="flex min-w-0 items-center gap-3">
      <.link href={~p"/"} class="flex shrink-0 items-center gap-2.5 lg:invisible">
        <img src={~p"/images/re-pinchflat-icon.svg"} alt="re:Pinchflat" class="h-8 w-8" />
        <span class="hidden text-base font-bold tracking-tight text-white sm:block">
          re<span class="text-primary">:</span>Pinchflat
        </span>
      </.link>

      <button
        class="z-99999 block rounded-sm border border-stroke bg-white p-1.5 shadow-sm dark:border-strokedark dark:bg-boxdark lg:hidden"
        @click.stop="sidebarVisible = !sidebarVisible"
      >
        <.icon name="hero-bars-3" />
      </button>
    </div>

    <div class="flex items-center gap-3">
      <div class="w-44 sm:w-64 xl:w-80">
        <div class="relative">
          <span class="absolute left-2 top-1/2 -translate-y-1/2 flex">
            <.icon name="hero-magnifying-glass" />
          </span>
          <form action={~p"/search"}>
            <input
              type="text"
              name="q"
              value={@params["q"]}
              placeholder="Search all media..."
              class="w-full bg-transparent py-1.5 pl-9 pr-4 border-0 focus:ring-0 focus:outline-none"
            />
          </form>
        </div>
      </div>

      {live_render(@conn, Pinchflat.Pages.StatusChipsLive, id: "status-chips")}
    </div>
  </div>
</header>
